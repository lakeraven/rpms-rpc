#!/usr/bin/env bash
# bin/cloud_rpms — run this gem's pinned RPMS release on a machine with Docker but no route to a
# staging stack (a cloud agent VM), so wire:capture, bin/console and live tests reach a broker.
#
#   bin/cloud_rpms up       start dockerd if needed, then run the pinned image; wait until healthy
#   bin/cloud_rpms down     stop and remove the container (the volume stays)
#   bin/cloud_rpms status   show the container and its health
#
# The run recipe is not kept here: this calls lakeraven-ehr's compose.yml (its `rpms` service) with
# RPMS_IMAGE set to the release to run. Point LAKERAVEN_EHR_PATH at a lakeraven-ehr checkout
# (default: ../lakeraven-ehr). The CIA broker is on 127.0.0.1:9100.
#
# Which release, first match wins:
#   RPMS_IMAGE=<ref>   any image ref, e.g. a digest
#   RPMS_TAG=<tag>     a gated rpms-ops release tag, to reproduce a specific build
#   PINNED=1           the newest `image:` in data/fingerprints/rpms-ops.lock.yml (what the
#                      conformance fixtures were captured from)
#   (default)          the rpms-ops release marked Latest, the newest one that passed the gate;
#                      the lock pin when the releases API can't be reached
#
# The compose project is named rpms-rpc. A release refuses another build's /data (rpms-ops#514),
# so when the release changes, `up` removes this project's container and volume first: it holds
# only synthetic data.
#
# Pull access to ghcr.io/lakeraven is needed: `docker login ghcr.io` on a laptop, or the cloud
# environment's ghcr.io network secret, which reaches dockerd through the inherited HTTPS_PROXY.
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
EHR="${LAKERAVEN_EHR_PATH:-$ROOT/../lakeraven-ehr}"
LOCK="$ROOT/data/fingerprints/rpms-ops.lock.yml"
LOG_DIR="${TMPDIR:-/tmp}"

log() { printf '[cloud_rpms] %s\n' "$*" >&2; }

compose() {
  [ -f "$EHR/compose.yml" ] || { log "no compose.yml under $EHR; set LAKERAVEN_EHR_PATH"; exit 1; }
  docker compose -f "$EHR/compose.yml" -p rpms-rpc "$@"
}

REPO_IMAGE=ghcr.io/lakeraven/rpms-ydb

lock_image() {
  local img
  img=$(grep -E '^[[:space:]]+image: ' "$LOCK" | tail -1 | awk '{print $2}')
  [ -n "$img" ] || { log "no image: in $LOCK; set RPMS_IMAGE= or RPMS_TAG="; exit 1; }
  echo "$img"
}

wanted_image() {
  if [ -n "${RPMS_IMAGE:-}" ]; then echo "$RPMS_IMAGE"; return; fi
  if [ -n "${RPMS_TAG:-}" ]; then echo "$REPO_IMAGE:$RPMS_TAG"; return; fi
  if [ -n "${PINNED:-}" ]; then lock_image; return; fi
  # On failure gh still prints the error body to stdout, so take the tag only on success and only
  # when it is a well-formed Docker tag.
  local tag
  if tag=$(gh api repos/lakeraven/rpms-ops/releases/latest --jq .tag_name 2>/dev/null) &&
     [[ "$tag" =~ ^[A-Za-z0-9_][A-Za-z0-9_.-]{0,127}$ ]]; then
    echo "$REPO_IMAGE:$tag"; return
  fi
  log "can't read the Latest rpms-ops release; using the lock pin"
  lock_image
}

ensure_dockerd() {
  command -v docker >/dev/null || { log "docker CLI not installed"; exit 1; }
  if docker info >/dev/null 2>&1; then return; fi
  command -v dockerd >/dev/null || { log "dockerd not installed and no daemon is running"; exit 1; }
  log "starting dockerd (log: $LOG_DIR/dockerd.log)"
  # dockerd inherits HTTPS_PROXY/NO_PROXY, so registry pulls go through the VM's egress proxy.
  nohup dockerd >"$LOG_DIR/dockerd.log" 2>&1 &
  for _ in $(seq 1 30); do docker info >/dev/null 2>&1 && return; sleep 1; done
  log "dockerd did not come up; tail of its log:"; tail -20 "$LOG_DIR/dockerd.log" >&2; exit 1
}

health() {
  local id; id=$(compose ps -q rpms 2>/dev/null)
  if [ -z "$id" ]; then echo none; return; fi
  docker inspect -f '{{.State.Health.Status}}' "$id"
}

up() {
  ensure_dockerd
  RPMS_IMAGE=$(wanted_image)
  export RPMS_IMAGE
  local id; id=$(compose ps -aq rpms 2>/dev/null)
  if [ -n "$id" ] && [ "$(docker inspect -f '{{.Config.Image}}' "$id")" != "$RPMS_IMAGE" ]; then
    log "release changed; removing this project's container and its /data volume"
    compose rm --stop --force rpms
    docker volume rm rpms-rpc_rpms-data >/dev/null
  fi
  log "running $RPMS_IMAGE through $EHR/compose.yml"
  if ! compose up -d rpms; then
    log "start failed. On 'unauthorized' or 'denied', this machine has no working ghcr.io credential."
    exit 1
  fi
  # The compose healthcheck checks LISTEN, not a connect: a connect is a broker session (rpms-ops#444).
  for _ in $(seq 1 60); do
    if [ "$(health)" = healthy ]; then
      log "broker is listening on 127.0.0.1:9100"
      echo "BROKER=cia BROKER_HOST=127.0.0.1 BROKER_PORT=9100"
      return
    fi
    sleep 5
  done
  log "not healthy within 5 minutes; container log tail:"
  compose logs --tail 40 rpms >&2 || true
  exit 1
}

case "${1:-}" in
  up) up ;;
  down) compose rm --stop --force rpms ;;
  status) compose ps rpms; log "health: $(health)" ;;
  *) echo "usage: bin/cloud_rpms up|down|status" >&2; exit 2 ;;
esac
