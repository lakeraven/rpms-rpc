#!/usr/bin/env bash
# Run one factory seat, named by its ROLE, on a brief file.
#
#   bin/seat <role> <brief-file>
#   bin/seat probe
#
# Roles (what the factory needs done, not who does it):
#   spec         writes the failing tests first       (a different vendor from build)
#   build        makes the tests pass, ordinary work
#   build-hard   the same, for auth, credentials, money, PHI, concurrency
#   gate         reviewer 1, read-only                (a different vendor from build)
#   gate2        reviewer 2, read-only                (a third vendor, when one is available)
#   probe        is a gate2 seat reachable? (no brief)
#
# Each role has a CHAIN: provider:model links tried left to right. A link that is
# unavailable (CLI missing, signed out, out of usage, or a provider-side failure) passes the
# role to the next link. The first link that answers is the seat; its output is streamed,
# its last line is
#   SEAT_VENDOR role=<role> vendor=<vendor> cli=<provider> model=<model>
# and the exit is 0. A run that fails for any other reason (a timeout, a crash) keeps its
# own exit code and the chain stops there.
#
# Providers:
#   cursor:<model>   the Cursor agent CLI ($HOME/.local/bin/agent), sandboxed
#   codex:<model>    the Codex CLI, read-only and ephemeral, without the user's config;
#                    "codex:default" uses the CLI's default model. Read-only, so it is
#                    allowed only in the gate and gate2 chains
#   native:<model>   the caller plays the role itself with a fresh Claude subagent on that
#                    model (read-only for gate and gate2). bin/seat prints
#                      SEAT_FALLBACK role=<role> model=<model>
#                    and exits 75. Put it last: nothing after it is tried.
# A chain that runs out without a native link exits 69.
#
# The chains live in ONE place: the table below, or etc/seats.conf when that file exists.
# Prompts, allow rules and docs say the role only, so swapping a model or a provider is a
# one-line change there and nothing else. etc/seats.conf is parsed, never sourced: one line
# per role, "<role> <link> [<link> ...]", '#' starts a comment.
#
# Why this exists: cloud sessions allow `Bash(bin/seat <role>:*)` in
# .claude/settings.json. A seat call composed by hand (cd ... &&, a heredoc,
# "$(cat brief)") does not match an allow rule, so auto mode judges it and
# refuses it. Write the brief to a file, then run this as its own Bash call.
#
# The brief is passed as the agent's prompt. This script never prints
# environment values; each CLI reads its own credentials.
#
# Every seat runs SANDBOXED: Cursor with --sandbox enabled (the same posture as
# bin/agent-timed; --trust only skips the workspace prompt, -f is not passed), Codex with
# --sandbox read-only. A seat that needs the host (a test the sandbox blocks, such as
# Socket.ip_address_list) reports it; the worker re-runs that check itself. Do not add an
# unsandboxed mode here: this script sits behind an allow rule, so whatever it runs, every
# cloud session can run. Send only synthetic data to any seat.
set -euo pipefail

# ---- the only place a model is named (default chains, and time limits in seconds) --------
chain_spec="cursor:composer-2.5 native:fable";          secs_spec=1200
chain_build="cursor:grok-4.7-high native:sonnet";       secs_build=2400
chain_build_hard="cursor:grok-4.7-xhigh native:opus";   secs_build_hard=2400
chain_gate="cursor:composer-2.5 native:fable";          secs_gate=1200
chain_gate2="codex:gpt-5.6-terra cursor:glm-5.2-high native:opus"; secs_gate2=1200
# build-hard and gate2 both end in native opus, so a caller whose build-hard fell back skips
# the gate2 fallback rather than have a model review its own build.
# Reasoning effort for Codex links (--ignore-user-config drops the user's setting).
effort_codex=high
# -----------------------------------------------------------------------------------------

conf=etc/seats.conf
if [ -f "$conf" ] && [ ! -L "$conf" ]; then
  while IFS= read -r line || [ -n "$line" ]; do
    line="${line%%#*}"
    read -r r links <<<"$line" || true
    [ -n "${r:-}" ] || continue
    case "$r" in spec|build|build-hard|gate|gate2) ;; *) echo "bin/seat: $conf: unknown role: $r" >&2; exit 78 ;; esac
    for l in $links; do
      [[ "$l" =~ ^(cursor|codex|native):[A-Za-z0-9._-]+$ ]] || { echo "bin/seat: $conf: bad link for $r: $l" >&2; exit 78; }
      case "$r:$l" in gate:codex:*|gate2:codex:*) ;; *:codex:*) echo "bin/seat: $conf: codex is read-only, not allowed for $r" >&2; exit 78 ;; esac
    done
    [ -n "$links" ] || { echo "bin/seat: $conf: empty chain for $r" >&2; exit 78; }
    printf -v "chain_${r//-/_}" '%s' "$links"
  done <"$conf"
fi

usage() { sed -n '2,/^# Why this exists/p' "$0" | sed '$d' | sed 's/^# \{0,1\}//' >&2; exit 64; }

cursor_agent="$HOME/.local/bin/agent"
seat_out=""
trap 'rm -f "$seat_out"' EXIT
trap 'exit 143' TERM
trap 'exit 130' INT

vendor_of() {
  case "$1" in
    composer*) echo cursor ;;   grok*) echo xai ;;       glm*) echo zhipu ;;
    kimi*) echo moonshot ;;     gemini*) echo google ;;  gpt*|o[0-9]*|default) echo openai ;;
    claude*|fable*|opus*|sonnet*|haiku*) echo anthropic ;;
    *) echo unknown ;;
  esac
}

# Each provider runs one link. Return 0 when it answered, 75 when the provider is unavailable
# (try the next link), anything else for a real failure.
provider_cursor() { # <model> <secs> <prompt>
  [ -x "$cursor_agent" ] || return 75
  local rc=0
  seat_out="$(mktemp)"
  timeout "$2" "$cursor_agent" -p --trust --sandbox enabled --model "$1" "$3" 2>&1 | tee "$seat_out" || rc=$?
  # Only a FAILED run that reports Cursor's out-of-usage error is "unavailable": a seat that
  # succeeds while quoting that text (a gate reviewing this script) keeps its success.
  if [ "$rc" -ne 0 ] && grep -q 'ActionRequiredError' "$seat_out" &&
    grep -Eqi "out of usage|usage limit" "$seat_out"; then
    rc=75
  fi
  rm -f "$seat_out"
  return "$rc"
}

provider_codex() { # <model> <secs> <prompt>
  command -v codex >/dev/null 2>&1 || return 75
  local rc=0 model=()
  [ "$1" = default ] || model=(--model "$1")
  timeout "$2" codex exec --sandbox read-only --skip-git-repo-check --ignore-user-config \
    --ephemeral -c model_reasoning_effort="$effort_codex" "${model[@]}" "$3" </dev/null || rc=$?
  # Codex reports a signed-out CLI, a refused model or a provider error with exit 1, which hands
  # the role on. A timeout (124), a signal (128+n) or any other exit is a real failure.
  [ "$rc" -ne 1 ] || rc=75
  return "$rc"
}

run_chain() { # <role> <secs> <prompt>
  local role=$1 secs=$2 prompt=$3 var="chain_${1//-/_}" link provider model rc
  for link in ${!var}; do
    provider=${link%%:*} model=${link#*:}
    case "$provider" in
      native)
        echo "SEAT_FALLBACK role=$role model=$model"
        exit 75 ;;
      cursor|codex)
        case "$role:$provider" in
          gate:codex|gate2:codex|*:cursor) ;;
          *) echo "bin/seat: codex is read-only, not allowed for $role" >&2; exit 78 ;;
        esac
        rc=0
        "provider_$provider" "$model" "$secs" "$prompt" || rc=$?
        if [ "$rc" -eq 0 ]; then
          echo "SEAT_VENDOR role=$role vendor=$(vendor_of "$model") cli=$provider model=$model"
          exit 0
        fi
        [ "$rc" -eq 75 ] || exit "$rc"
        echo "bin/seat: $role on $link unavailable; trying the next link" >&2 ;;
    esac
  done
  echo "bin/seat: no seat in the $role chain is available" >&2
  exit 69
}

role="${1:-}"
case "$role" in
  spec)       secs=$secs_spec ;;
  build)      secs=$secs_build ;;
  build-hard) secs=$secs_build_hard ;;
  gate)       secs=$secs_gate ;;
  gate2)      secs=$secs_gate2 ;;
  probe)      run_chain gate2 120 'Reply with exactly: PROBE_OK' ;;
  *)          usage ;;
esac

brief="${2:-}"
[ -n "$brief" ] || usage
[ -f "$brief" ] && [ -s "$brief" ] || { echo "bin/seat: brief file is missing or empty: $brief" >&2; exit 66; }

# The brief is sent to a remote model API, so it must be a file written for the purpose, not
# whatever file a caller names. It must be a regular file (not a symlink), inside the working
# directory or the temp directory, with no hidden path component (.git, .env, .ssh ...), and
# small. Anything else is refused before a byte of it is read.
brief_refused() { echo "bin/seat: brief not allowed: $1 ($brief)" >&2; exit 65; }
[ ! -L "$brief" ] || brief_refused "a symlink"
dir="$(cd -- "$(dirname -- "$brief")" 2>/dev/null && pwd -P)" || brief_refused "no such directory"
resolved="$dir/$(basename -- "$brief")"
work="$(pwd -P)"
tmp="$(cd -- "${TMPDIR:-/tmp}" 2>/dev/null && pwd -P)" || tmp=/tmp
tmp2="$(cd -- /tmp 2>/dev/null && pwd -P)" || tmp2=/tmp
case "$resolved" in
  "$work"/*) rel="${resolved#"$work"/}" ;;
  "$tmp"/*)  rel="${resolved#"$tmp"/}" ;;
  "$tmp2"/*) rel="${resolved#"$tmp2"/}" ;;
  *)         brief_refused "outside the working directory and the temp directory" ;;
esac
case "/$rel" in */.*) brief_refused "a hidden path component" ;; esac
[ "$(wc -c < "$resolved")" -le 262144 ] || brief_refused "larger than 256 KiB"

# The prompt starts with a fixed line so a brief that begins with "-" can never be read as an
# option (a brief of "--sandbox=..." must stay prompt text).
prompt="$(printf 'Brief (the whole task follows):\n\n'; cat -- "$resolved")"
run_chain "$role" "$secs" "$prompt"

