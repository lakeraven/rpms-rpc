#!/usr/bin/env bash
# Run one Cursor-hosted factory seat, named by its ROLE, on a brief file.
#
#   bin/seat <role> <brief-file>
#   bin/seat probe
#
# Roles (what the factory needs done, not who does it):
#   spec         writes the failing tests first       (a different vendor from build)
#   build        makes the tests pass, ordinary work
#   build-hard   the same, for auth, credentials, money, PHI, concurrency
#   gate         reviewer 1, read-only                (a different vendor from build)
#   gate2        reviewer 2, read-only                (a third vendor, when one is available)
#   probe        is the gate2 seat reachable? (no brief)
#
# When the Cursor seat is unavailable, gate2 (and probe) first try the Codex CLI (OpenAI). If it
# answers, its output is the seat's output, the last line is
#   SEAT_VENDOR role=gate2 vendor=openai cli=codex model=<id|default>
# and the exit is 0. Codex runs read-only and ephemeral, without the user's config.toml. If it
# is missing, signed out or fails, gate2 falls through to the native fallback below.
#
# When Cursor is out of usage the seat cannot run. The script then prints one line,
#   SEAT_FALLBACK role=<role> model=<opus|sonnet|fable>
# and exits 75. The caller plays that role itself with a fresh native Claude subagent on
# that model (read-only for gate and gate2), and its panel record says the seats were
# native: one vendor, not the cross-vendor panel. Any other failure is passed through.
#
# Prompts, allow rules and docs say the role only. The model behind a role is named in ONE
# place, the table below, so swapping a model is a one-line change here and nothing else.
#
# Why this exists: cloud sessions allow `Bash(bin/seat <role>:*)` in
# .claude/settings.json. A seat call composed by hand (cd ... &&, a heredoc,
# "$(cat brief)") does not match an allow rule, so auto mode judges it and
# refuses it. Write the brief to a file, then run this as its own Bash call.
#
# The brief is passed as the agent's prompt. This script never prints
# environment values; the agent reads CURSOR_API_KEY itself.
#
# Every seat runs SANDBOXED (--sandbox enabled), the same posture as
# bin/agent-timed. --trust only skips the workspace prompt; it does not lift the
# sandbox, and -f (force) is not passed. A seat that needs the host (a test
# the sandbox blocks, such as Socket.ip_address_list) reports it; the worker
# re-runs that check itself. Do not add an unsandboxed mode here: this script
# sits behind an allow rule, so whatever it runs, every cloud session can run.
set -euo pipefail

# ---- the only place a model is named (and its time limit, in seconds) -------------------
model_spec=composer-2.5;        secs_spec=1200
model_build=grok-4.7-high;      secs_build=2400
model_build_hard=grok-4.7-xhigh; secs_build_hard=2400
model_gate=composer-2.5;        secs_gate=1200
model_gate2=glm-5.2-high;       secs_gate2=1200
# Native fallbacks, used only when Cursor answers that it is out of usage. build-hard and
# gate2 share opus, so a caller whose build-hard fell back skips the gate2 fallback rather
# than have a model review its own build.
fallback_spec=fable
fallback_build=sonnet
fallback_build_hard=opus
fallback_gate=fable
fallback_gate2=opus
# Second-vendor gate2 when the Cursor seat is unavailable: the Codex CLI (OpenAI). An empty
# model means the CLI's default; codex_gate2=off goes straight to the native fallback. Send
# only synthetic data through it. --ignore-user-config also drops any reasoning setting, so
# the effort is set here.
codex_gate2=on
model_codex_gate2=""
effort_codex_gate2=high
# -----------------------------------------------------------------------------------------

agent="$HOME/.local/bin/agent"
usage() { sed -n '2,/^# Why this exists/p' "$0" | sed '$d' | sed 's/^# \{0,1\}//' >&2; exit 64; }

[ -x "$agent" ] || { echo "bin/seat: $agent is missing or not executable" >&2; exit 69; }

role="${1:-}"
# Run the agent, streaming its output, and turn Cursor's out-of-usage answer into the
# fallback line. The CLI reports it as ActionRequiredError ("You're out of usage" /
# "usage limit") and exits non-zero. Only a FAILED run that says so maps to a fallback: a
# seat that succeeds while quoting that text (a gate reviewing this script) keeps its
# success, and any other failure keeps its own exit code.
seat_out=""
codex_prompt=""
codex_secs=$secs_gate2
trap 'rm -f "$seat_out"' EXIT
trap 'exit 143' TERM
trap 'exit 130' INT
# gate2 only: when the Cursor seat is unavailable, try Codex before the native fallback. Exits 0
# when Codex answers; returns (so the caller prints SEAT_FALLBACK) when it is off, missing or
# fails.
codex_seat() {
  [ "$codex_gate2" = on ] && [ -n "$codex_prompt" ] || return 0
  command -v codex >/dev/null 2>&1 || return 0
  local rc=0
  timeout "$codex_secs" codex exec --sandbox read-only --skip-git-repo-check \
    --ignore-user-config --ephemeral -c model_reasoning_effort="$effort_codex_gate2" \
    ${model_codex_gate2:+--model "$model_codex_gate2"} \
    "$codex_prompt" </dev/null || rc=$?
  if [ "$rc" -eq 0 ]; then
    echo "SEAT_VENDOR role=gate2 vendor=openai cli=codex model=${model_codex_gate2:-default}"
    exit 0
  fi
  echo "bin/seat: codex gate2 failed (exit $rc); using the native fallback" >&2
}

run_seat() {
  local role=$1 fallback=$2
  shift 2
  local rc=0
  seat_out="$(mktemp)"
  "$@" 2>&1 | tee "$seat_out" || rc=$?
  if [ "$rc" -ne 0 ] && grep -q 'ActionRequiredError' "$seat_out" &&
    grep -Eqi "out of usage|usage limit" "$seat_out"; then
    [ "$role" != gate2 ] || codex_seat
    echo "SEAT_FALLBACK role=$role model=$fallback"
    exit 75
  fi
  exit "$rc"
}

case "$role" in
  spec)       model=$model_spec;       secs=$secs_spec;       fallback=$fallback_spec ;;
  build)      model=$model_build;      secs=$secs_build;      fallback=$fallback_build ;;
  build-hard) model=$model_build_hard; secs=$secs_build_hard; fallback=$fallback_build_hard ;;
  gate)       model=$model_gate;       secs=$secs_gate;       fallback=$fallback_gate ;;
  gate2)      model=$model_gate2;      secs=$secs_gate2;      fallback=$fallback_gate2 ;;
  probe)      codex_prompt='Reply with exactly: PROBE_OK'; codex_secs=120
              run_seat gate2 "$fallback_gate2" timeout 120 "$agent" -p --trust --sandbox enabled --model "$model_gate2" 'Reply with exactly: PROBE_OK' ;;
  *)          usage ;;
esac

brief="${2:-}"
[ -n "$brief" ] || usage
[ -f "$brief" ] && [ -s "$brief" ] || { echo "bin/seat: brief file is missing or empty: $brief" >&2; exit 66; }

# The brief is sent to a remote model API, so it must be a file written for the purpose, not
# whatever file a caller names. It must be a regular file (not a symlink), inside the working
# directory or the temp directory, with no hidden path component (.git, .env, .ssh ...), and
# small. Anything else is refused before a byte of it is read.
brief_refused() { echo "bin/seat: brief not allowed: $1 ($brief)" >&2; exit 65; }
[ ! -L "$brief" ] || brief_refused "a symlink"
dir="$(cd -- "$(dirname -- "$brief")" 2>/dev/null && pwd -P)" || brief_refused "no such directory"
resolved="$dir/$(basename -- "$brief")"
work="$(pwd -P)"
tmp="$(cd -- "${TMPDIR:-/tmp}" 2>/dev/null && pwd -P)" || tmp=/tmp
tmp2="$(cd -- /tmp 2>/dev/null && pwd -P)" || tmp2=/tmp
case "$resolved" in
  "$work"/*) rel="${resolved#"$work"/}" ;;
  "$tmp"/*)  rel="${resolved#"$tmp"/}" ;;
  "$tmp2"/*) rel="${resolved#"$tmp2"/}" ;;
  *)         brief_refused "outside the working directory and the temp directory" ;;
esac
case "/$rel" in */.*) brief_refused "a hidden path component" ;; esac
[ "$(wc -c < "$resolved")" -le 262144 ] || brief_refused "larger than 256 KiB"

# The prompt starts with a fixed line so a brief that begins with "-" can never be read as an
# option (a brief of "--sandbox=..." must stay prompt text).
prompt="$(printf 'Brief (the whole task follows):\n\n'; cat -- "$resolved")"
[ "$role" != gate2 ] || codex_prompt=$prompt

run_seat "$role" "$fallback" timeout "$secs" "$agent" -p --trust --sandbox enabled --model "$model" "$prompt"
