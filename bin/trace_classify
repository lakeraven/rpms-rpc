#!/usr/bin/env ruby
# frozen_string_literal: true

# Classify the RPCs in a VueCentric/VIM trace export into MVC tiers and
# frontend-coupling dispositions, per ADR 0004.
#
#   bin/trace_classify path/to/TraceLogExport.xml [--tsv out.tsv]
#
# Judgement lives in data/rpc_tiers/rules.yml, not here. This script only
# applies it and regenerates data/rpc_tiers/{canonical,quarantine,legacy}.txt.
#
# Re-run it when a new trace lands: new RPCs default to canonical, which is the
# safe direction — an unclassified presentation RPC shows up as a review
# question rather than silently entering the stack.

require "rexml/document"
require "yaml"
require "set"

ROOT = File.expand_path("..", __dir__)
TIER_DIR = File.join(ROOT, "data", "rpc_tiers")

trace_path = ARGV.find { |a| !a.start_with?("--") }
abort "usage: bin/trace_classify <trace.xml> [--tsv <path>]" unless trace_path
abort "no such trace: #{trace_path}" unless File.exist?(trace_path)
tsv_path = ARGV[ARGV.index("--tsv") + 1] if ARGV.include?("--tsv")

rules = YAML.safe_load_file(File.join(TIER_DIR, "rules.yml"))
VIEW       = Set.new(rules.fetch("view"))
DIALOG     = Set.new(rules.fetch("dialog"))
CONTROL    = Set.new(rules.fetch("control"))
QUARANTINE = Set.new(rules.fetch("quarantine"))

overlap = [%w[view dialog], %w[view control], %w[dialog control]].filter_map do |a, b|
  dup = Set.new(rules.fetch(a)) & Set.new(rules.fetch(b))
  "#{a}/#{b}: #{dup.to_a.join(', ')}" unless dup.empty?
end
abort "rules.yml tiers overlap -> #{overlap.join('; ')}" unless overlap.empty?

# The trace is an operator-supplied file; disable entity expansion so a
# malformed or hostile export cannot expand into a denial of service.
doc = REXML::Document.new(File.read(trace_path), ignore_whitespace_nodes: :all)
REXML::Document.entity_expansion_limit = 0

calls = Hash.new(0)
doc.elements.each("VIMTraceLog/Item") do |item|
  sub = item.elements.to_a("SubItem").each_with_object({}) { |s, h| h[s.attribute("Index").value] = s.text.to_s.strip }
  calls[sub["1"]] += 1 if sub["0"].to_s.start_with?("RPC")
end
abort "no RPC items found in #{trace_path}" if calls.empty?

COUPLING = lambda do |rpc, tier|
  return "cprs-dialog-machine" if tier == "C-dialog"
  return "vuecentric-framework" if rpc.start_with?("CIAVMRPC", "CIAURPC", "CIANBRPC")
  return "vuecentric-component" if rpc.start_with?("BGOUTL", "BGOCPTPR", "BGOSNOPR", "BGOTRG")
  return "tiu-editor" if rpc.start_with?("TIU TEMPLATE") ||
                         ["TIU GET LIST OF OBJECTS", "TIU LOAD BOILERPLATE TEXT",
                          "TIU FIELD LOAD", "TIU REM DLG OK AS TEMPLATE"].include?(rpc)
  return "cprs-chrome" if tier == "V"

  ""
end

rows = calls.sort_by { |rpc, n| [-n, rpc] }.map do |rpc, n|
  tier = if VIEW.include?(rpc) then "V"
         elsif DIALOG.include?(rpc) then "C-dialog"
         elsif CONTROL.include?(rpc) then "C"
         else "M"
         end
  disposition = if %w[V C-dialog].include?(tier) then "legacy"
                elsif QUARANTINE.include?(rpc) then "quarantine"
                else "canonical"
                end
  { rpc: rpc, calls: n, tier: tier, coupling: COUPLING.call(rpc, tier), disposition: disposition }
end

HEADERS = {
  "canonical" => <<~TXT,
    # CANONICAL — frontend-agnostic. Returns domain data, holds no client session
    # state, renders nothing. Safe to wrap and expose as rpms-rpc API.
  TXT
  "quarantine" => <<~TXT,
    # QUARANTINE — writes real clinical state, but its payload is CPRS dialog
    # state. Permitted ONLY behind a narrow adapter that builds the payload
    # internally. Never re-exported as canonical API.
  TXT
  "legacy" => <<~TXT,
    # LEGACY — contract presumes a specific legacy client (VueCentric shell, CPRS
    # order-dialog machine, TIU note editor). MUST NOT enter the canonical stack.
    # Wrapping one of these is a design error, not a coverage gain.
  TXT
}.freeze

%w[canonical quarantine legacy].each do |disposition|
  body = rows.select { |r| r[:disposition] == disposition }
  File.write(File.join(TIER_DIR, "#{disposition}.txt"), <<~OUT)
    #{HEADERS.fetch(disposition)}# Generated by bin/trace_classify from #{File.basename(trace_path)}.
    # Judgement lives in rules.yml. See docs/adr/0004-frontend-agnostic-rpc-tiers.md.
    #{body.map { |r| "#{r[:rpc]}\t# #{r[:tier]}#{" #{r[:coupling]}" unless r[:coupling].empty?}" }.join("\n")}
  OUT
end

if tsv_path
  File.write(tsv_path, (["rpc\tcalls\ttier\tcoupling\tdisposition"] +
    rows.map { |r| [r[:rpc], r[:calls], r[:tier], r[:coupling], r[:disposition]].join("\t") }).join("\n") + "\n")
end

by = ->(key, val) { rows.select { |r| r[key] == val } }
warn format("%-12s %5s %7s", "TIER", "RPCs", "calls")
%w[M C C-dialog V].each do |t|
  warn format("%-12s %5d %7d", t, by.call(:tier, t).size, by.call(:tier, t).sum { |r| r[:calls] })
end
warn ""
warn format("%-12s %5s %7s", "DISPOSITION", "RPCs", "calls")
%w[canonical quarantine legacy].each do |d|
  warn format("%-12s %5d %7d", d, by.call(:disposition, d).size, by.call(:disposition, d).sum { |r| r[:calls] })
end
