#!/usr/bin/env bash
# bin/factory_live_rpms — SessionStart hook. In an environment that sets FACTORY_LIVE_RPMS=1, start
# the pinned RPMS release in the background so a session finds a broker coming up on
# 127.0.0.1:9100 without running `bin/cloud_rpms up` itself. Anywhere else it does nothing.
#
# It returns at once and never fails session start. Progress goes to a state directory
# (FACTORY_LIVE_RPMS_DIR, default ~/.cache/factory_live_rpms; it must be a real directory the
# session user owns, or the hook does nothing):
#   status   starting, then healthy or failed
#   log      output of the clone (if one was needed) and of `bin/cloud_rpms up`
# A second session start while a run is in progress, or after a healthy one, starts nothing; after
# a failed run the next session start tries again.
#
# LAKERAVEN_EHR_PATH points at the lakeraven-ehr checkout whose compose.yml runs the image
# (default ../lakeraven-ehr); it is cloned when missing. CLOUD_RPMS overrides the script that is run
# (tests use this).
set -u

[ "${FACTORY_LIVE_RPMS:-}" = "1" ] || exit 0

ROOT="$(cd "$(dirname "$0")/.." && pwd)" || exit 0
EHR="${LAKERAVEN_EHR_PATH:-$ROOT/../lakeraven-ehr}"
CLOUD_RPMS="${CLOUD_RPMS:-$ROOT/bin/cloud_rpms}"
DIR="${FACTORY_LIVE_RPMS_DIR:-${HOME:-/nonexistent}/.cache/factory_live_rpms}"
STATUS="$DIR/status"
LOG="$DIR/log"

mkdir -p -m 700 "$DIR" 2>/dev/null || exit 0
# Not a symlink and ours, so status and log writes can't be redirected by another user.
{ [ -d "$DIR" ] && [ ! -L "$DIR" ] && [ -O "$DIR" ]; } || exit 0

# One run at a time: the background run holds an flock on $DIR/lock until it ends, so a session
# that starts meanwhile exits here. Once the run ends, a healthy stack is left alone and a failed
# one is tried again, as is a run that was killed (the kernel drops its lock). Children run with the lock's fd closed, so a dockerd that
# `bin/cloud_rpms up` leaves running does not keep holding it.
exec 9>"$DIR/lock" 2>/dev/null || exit 0
if command -v flock >/dev/null; then flock -n 9 || exit 0; fi
[ "$(cat "$STATUS" 2>/dev/null)" = "healthy" ] && exit 0

echo starting >"$STATUS"

(
  if [ ! -f "$EHR/compose.yml" ]; then
    git clone --depth 1 https://github.com/lakeraven/lakeraven-ehr.git "$EHR" 9>&- || {
      echo failed >"$STATUS"; exit 0
    }
  fi
  # The pinned release only: an inherited RPMS_IMAGE or RPMS_TAG would win over PINNED.
  if env -u RPMS_IMAGE -u RPMS_TAG LAKERAVEN_EHR_PATH="$EHR" PINNED=1 "$CLOUD_RPMS" up 9>&-; then
    echo healthy >"$STATUS"
  else
    echo failed >"$STATUS"
  fi
) >>"$LOG" 2>&1 </dev/null &

exit 0
