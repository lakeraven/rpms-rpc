{
  "permissions": {
    "allow": [
      "Bash(bin/cloud_rpms:*)",
      "Bash(PINNED=1 bin/cloud_rpms:*)",
      "Bash(LAKERAVEN_EHR_PATH=/home/user/lakeraven-ehr bin/cloud_rpms:*)",
      "Bash(LAKERAVEN_EHR_PATH=/home/user/lakeraven-ehr PINNED=1 bin/cloud_rpms:*)",
      "Bash(PINNED=1 LAKERAVEN_EHR_PATH=/home/user/lakeraven-ehr bin/cloud_rpms:*)",
      "Bash(bin/seat spec:*)",
      "Bash(bin/seat build:*)",
      "Bash(bin/seat build-hard:*)",
      "Bash(bin/seat gate:*)",
      "Bash(bin/seat gate2:*)",
      "Bash(bin/seat probe)",
      "Bash(gh api repos/lakeraven/rpms-rpc/:*)",
      "Bash(gh api -X POST repos/lakeraven/rpms-rpc/:*)",
      "Bash(gh api -X PATCH repos/lakeraven/rpms-rpc/:*)",
      "Bash(gh api -X PUT repos/lakeraven/rpms-rpc/:*)",
      "Bash(gh api -X DELETE repos/lakeraven/rpms-rpc/issues/:*)",
      "Bash(gh api repos/lakeraven/lakeraven-ehr/:*)",
      "Bash(gh api -X POST repos/lakeraven/lakeraven-ehr/:*)",
      "Bash(gh api -X PATCH repos/lakeraven/lakeraven-ehr/:*)",
      "Bash(gh api -X PUT repos/lakeraven/lakeraven-ehr/:*)",
      "Bash(gh api -X DELETE repos/lakeraven/lakeraven-ehr/issues/:*)",
      "Bash(gh api repos/lakeraven/factory/contents/etc/scope:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/bin/factory_live_rpms"
          }
        ]
      }
    ]
  }
}
